# Copier ce fichier en .env (dans le dossier server/) puis adapter les valeurs.
# Ce fichier-ci est committé : il ne doit contenir AUCUN secret.

# Port de l'API Express
PORT=3001

# Adresse du serveur Ollama (IA locale) et modèle utilisé
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Chemin du fichier SQLite
DB_PATH=./goodmaps.db
